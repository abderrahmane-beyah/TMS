# Base de données
POSTGRES_USER=postgres
POSTGRES_PASSWORD=votre-mot-de-passe-securise
POSTGRES_DB=tms_db

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:votre-mot-de-passe@localhost:5432/tms_db
SECRET_KEY=votre-cle-secrete-minimum-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Configuration du routing
ROUTING_BACKEND=osrm
OSRM_URL=http://localhost:5001
GOOGLE_MAPS_API_KEY=votre-cle-google-maps-optionnel

# Configuration du dépôt (coordonnées par défaut - Nouakchott)
DEFAULT_DEPOT_LAT=18.0735
DEFAULT_DEPOT_LON=-15.9582